# ============================================================
# docrag 环境变量示例
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# ============================================================

# ---------- LLM ----------
# deepseek 或 mimo
LLM_PROVIDER=deepseek

# 至少填当前使用的那一个
DEEPSEEK_API_KEY=
MIMO_API_KEY=

# 可选：按提供商分别覆盖默认地址和模型
# DeepSeek 当前在售：deepseek-flash / deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# MiMo 当前在售：mimo-v2.6-pro / mimo-v2.6-flash
# TokenPlan 用 https://token-plan-cn.xiaomimimo.com/v1，按量付费用 https://api.xiaomimimo.com/v1
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-pro

LLM_TEMPERATURE=0.1
# off=最快（推荐 RAG 问答），on=开启思考，auto=跟随服务端默认
LLM_THINKING=off
LLM_REASONING_EFFORT=low
# LLM_MAX_OUTPUT_TOKENS=

# ---------- Embedding ----------
# Qwen3-Embedding-0.6B：32K 上下文，CPU 可跑
# 备选：BAAI/bge-base-zh-v1.5（更快，但最大输入只有 512 token）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# MRL 降维，留空用模型默认（Qwen3-0.6B 是 1024）
# EMBEDDING_DIMENSIONS=1024

# ---------- 切分 ----------
CHUNK_SIZE=400
CHUNK_OVERLAP=60
MAX_CHUNK_CHARS=500

# ---------- 检索 ----------
RETRIEVE_TOP_K=10
CANDIDATE_K=30
DENSE_WEIGHT=1.0
BM25_WEIGHT=1.0
RRF_K=60
REWRITE_ENABLED=true

# ---------- 重排（默认关闭，CPU 上较慢）----------
RERANK_ENABLED=false
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---------- 路径 ----------
DATA_DIR=./data
STORAGE_DIR=./.docrag
MODEL_DIR=./models
LOG_DIR=./logs

# ---------- 模型下载源 ----------
# modelscope（国内推荐）或 huggingface
MODEL_SOURCE=modelscope
