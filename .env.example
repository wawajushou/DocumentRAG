# ============================================================
# 汽车仪表盘规范文档智能问答系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# ========== API 提供商选择 ==========
# 可选值: deepseek 或 mimo
API_PROVIDER=deepseek

# ========== DeepSeek API 配置 ==========
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL_NAME=deepseek-chat

# ========== MiMo API 配置 ==========
MIMO_API_KEY=your_mimo_api_key_here
# MIMO_API_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL_NAME=mimo-v2-pro

# ========== 模型配置 ==========
# 向量嵌入模型名称（默认使用 BGE 中文模型）
# EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# ========== 文档处理配置 ==========
# 文本分块大小（字符数，范围 100-2000）
# CHUNK_SIZE=800
# 文本分块重叠大小（字符数）
# CHUNK_OVERLAP=200

# ========== 检索配置 ==========
# 检索返回的文档数量（范围 1-20）
# RETRIEVE_TOP_K=5
# LLM 温度参数（范围 0-2，越低越确定）
# TEMPERATURE=0.1

# ========== 路径配置 ==========
# 向量数据库路径
# VECTOR_DB_PATH=./chroma_db
# 文档数据目录
# DATA_DIR=./data
# 模型缓存目录
MODEL_SCOPE_CACHE_DIR=./models

# ========== 功能开关 ==========
# 是否使用 ModelScope 国内镜像下载模型（无需 VPN，推荐 true）
USE_MODEL_SCOPE=true
# 是否使用 UnstructuredWordDocumentLoader（需要额外依赖）
# 注意：设置为 true 前需要先安装: pip install unstructured python-docx
USE_UNSTRUCTURED=false
