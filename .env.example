# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 模型下载配置
# 是否使用 ModelScope 国内镜像（无需 VPN）
USE_MODEL_SCOPE=false
# 模型缓存目录
MODEL_SCOPE_CACHE_DIR=./models

# 文档加载配置
# 是否使用 UnstructuredWordDocumentLoader（需要额外依赖，效果可能更好但需要下载模型）
# 注意：设置为 true 前需要先安装: pip install unstructured python-docx
USE_UNSTRUCTURED=true
